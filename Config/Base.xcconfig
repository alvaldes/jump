// Shared build settings for every configuration.

// Default: ad-hoc signing so the project builds without an Apple account.
// Ad-hoc signatures change on every build, which resets the Accessibility
// permission. Create Config/Signing.local.xcconfig to sign with your team.
CODE_SIGN_STYLE = Automatic
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =

#include? "Signing.local.xcconfig"
